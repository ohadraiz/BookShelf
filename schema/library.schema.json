{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookshelf.local/schema/library/1.0.0",
  "title": "BookShelf Library",
  "description": "A home library: its shelves and the books on them. Version 1.0.0. Field names follow schema.org/Book where one exists.",
  "type": "object",
  "required": ["format", "formatVersion", "exportedAt", "library", "books"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "bookshelf-library" },
    "formatVersion": {
      "description": "Semantic version of this format. Readers accept any 1.x file.",
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "exportedAt": { "type": "string", "format": "date-time" },
    "generator": { "type": "string" },
    "library": { "$ref": "#/$defs/library" },
    "books": {
      "type": "array",
      "items": { "$ref": "#/$defs/book" }
    }
  },
  "$defs": {
    "library": {
      "type": "object",
      "required": ["id", "name", "shelves"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "inLanguage": { "$ref": "#/$defs/lang" },
        "owners": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "yearlyGoal": { "type": "integer", "minimum": 0 },
        "shelves": {
          "description": "In display order. Shelf 1 is the first item.",
          "type": "array",
          "items": { "$ref": "#/$defs/shelf" }
        }
      }
    },
    "shelf": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" }
      }
    },
    "book": {
      "type": "object",
      "required": ["id", "work", "copy"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "work": { "$ref": "#/$defs/work" },
        "copy": { "$ref": "#/$defs/copy" },
        "reading": { "$ref": "#/$defs/reading" }
      }
    },
    "work": {
      "description": "What the book is. Same for every copy of this edition in any library.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "description": "Title. Absent when not yet identified.", "type": "string", "minLength": 1 },
        "alternativeHeadline": { "description": "Subtitle.", "type": "string" },
        "author": {
          "description": "One entry per person. Empty or absent when unknown.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "translator": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "inLanguage": { "$ref": "#/$defs/lang" },
        "isbn": { "description": "ISBN-13, digits only.", "type": "string", "pattern": "^97[89]\\d{10}$" },
        "publisher": { "type": "string" },
        "datePublished": { "description": "Year, or full date.", "type": "string", "pattern": "^\\d{4}(-\\d{2}-\\d{2})?$" },
        "numberOfPages": { "type": "integer", "minimum": 1 }
      }
    },
    "copy": {
      "description": "This physical copy in this library.",
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "shelf": { "description": "Shelf id. Books with status want are kept off the shelf display.","$ref": "#/$defs/id" },
        "position": { "description": "1-based place on the shelf, right to left.", "type": "integer", "minimum": 1 },
        "status": { "enum": ["shelf", "reading", "read", "want", "lent", "borrowed", "given"] },
        "person": { "description": "Who it was lent to or borrowed from.", "type": "string" },
        "dueDate": { "$ref": "#/$defs/date" },
        "needsReview": { "description": "Identification is not certain.", "type": "boolean" },
        "coverFront": { "description": "Image asset id.", "type": "string" },
        "coverBack": { "description": "Image asset id.", "type": "string" }
      }
    },
    "reading": {
      "description": "The reader's own record. Absent when empty.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
        "review": { "type": "string" },
        "notes": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "currentPage": { "type": "integer", "minimum": 1 },
        "startDate": { "$ref": "#/$defs/date" },
        "endDate": { "$ref": "#/$defs/date" }
      }
    },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "lang": { "description": "BCP 47 language tag.", "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" }
  }
}
